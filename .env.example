# ログレベル
LOG_LEVEL=info

# ======================================================
# AI (Claude API) 設定 — 未設定でもクローラは動作 (AI機能のみ無効化)
# ======================================================

# Claude API キー (必須：AI機能を使う場合)
ANTHROPIC_API_KEY=

# AI モデル (省略時: claude-sonnet-4-6)
# AI_MODEL=claude-sonnet-4-6

# AI評価ルールを有効化
# true: 決定的ルール + AI ルール
# false: 決定的ルールのみ (default)
AI_EVALUATION_ENABLED=false

# 修正提案の事前生成モード (クロール終了時に AI 提案を先読み)
#   all      : 失敗したすべての audit について先読み (default when AI 有効)
#   critical : critical severity のみ先読み
#   none     : 事前生成しない (ダッシュボードからクリック時に都度生成)
AI_PREFETCH=all

# AI応答の最大トークン (省略時: 2048)
# AI_MAX_TOKENS=2048

# ======================================================
# ダッシュボード管理者モード (簡易認証)
# ======================================================
# 本番では必ず変更すること。未設定時は admin / change-me が既定値。
ADMIN_ID=admin
ADMIN_PASS=change-me
